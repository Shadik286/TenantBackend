generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Plan {
  id                  String   @id @default(uuid())
  name                String   @unique
  max_houses          Int
  max_units_per_house Int      @default(5)
  // Cap on active (non-soft-deleted) tenants across ALL of the owner's
  // houses — unlike max_units_per_house, which is per house. PRO stores
  // the Int32.MAX sentinel here, same convention as the other two caps.
  max_tenants         Int      @default(3)
  // Length of the trial window handed to a new user on this plan. Read at
  // registration instead of a hard-coded constant so changing the trial is
  // a data change, not a deploy.
  trial_days          Int      @default(30)
  price_monthly       Decimal  @db.Decimal(14, 2)
  features            Json
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  subscriptions Subscription[]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  full_name     String
  phone         String?   @unique
  is_verified   Boolean   @default(false)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  /// bcrypt hash of the user's 6-digit unlock PIN.
  ///
  /// The PIN is NOT a remote credential and this column is never accepted as
  /// proof of identity on its own — six digits is 10^6 combinations, which a
  /// server-side check would let an attacker walk through. The PIN is
  /// verified on the device, against a hash in the platform keystore, and
  /// what it actually unlocks is the stored refresh token.
  ///
  /// This copy exists so the same PIN survives a reinstall: after the user
  /// re-authenticates properly (Google / bdapps OTP) the client can pull the
  /// hash back down rather than forcing them to choose a new PIN. Writing it
  /// requires a valid access token, so setting a PIN is already authenticated.
  pin_hash      String?
  pin_set_at    DateTime?

  /// Bumped to invalidate every access token already issued to this user.
  ///
  /// Access JWTs carry the version they were minted at; `requireUserId()`
  /// compares that claim against this column and rejects anything stale.
  /// Without it a leaked JWT stayed valid until expiry with no way to kill it
  /// (SEC-004a) — the whole point of shortening the JWT to an hour is that
  /// this gives us a revocation switch for the window that remains.
  token_version Int       @default(0)

  /// Which flow created this account: "bdapps" (phone + carrier gateway),
  /// "google" (Play Store build), or "local" (email + password).
  ///
  /// This is a security boundary, not bookkeeping. `/api/auth/bdapps/login`
  /// mints a session from a phone number alone, so without this column that
  /// route can reach ANY user who happens to have a phone number on file —
  /// including email/password and Google accounts. Scoping the lookup to
  /// `provider = "bdapps"` is what stops a phone number being a master key
  /// to the whole user table. See SECURITY_ISSUES.md SEC-001.
  provider      String    @default("local")

  /// Google's stable subject identifier (the `sub` claim). Preferred over
  /// email for matching returning Google users: `sub` never changes, whereas
  /// a Workspace email can be renamed or reassigned to a different person —
  /// which would silently hand them the previous owner's account.
  google_sub    String?   @unique

  /// Whether ownership of `phone` has actually been proven.
  ///
  /// true  — bdapps accounts: the carrier gateway ran OTP before we ever saw
  ///         the number.
  /// false — Google/local accounts: the user typed it and nobody checked.
  ///
  /// No OTP flow exists for non-bdapps users yet (a deliberate scoping call —
  /// it needs an SMS vendor). This column is the seam that makes adding one
  /// later a migration-free change, and it lets F4 decide whether an
  /// unverified number may claim a paid subscription. Uniqueness on `phone`
  /// already prevents claiming a number somebody else has registered.
  phone_verified Boolean  @default(false)

  subscription   Subscription?
  houses         House[]
  audit_logs     AuditLog[]    @relation("AuditActor")
  preference     UserPreference?
  refresh_tokens     RefreshToken[]
  coupon_redemptions CouponRedemption[]
  subscription_auths SubscriptionAuthorization[]

  @@index([email])
  @@index([is_active, deleted_at])
  @@index([provider, phone])
}

model UserPreference {
  id            String   @id @default(uuid())
  user_id       String   @unique
  notifications String   @default("all")
  language      String   @default("en-US")
  appearance    String   @default("system")
  currency      String   @default("MAD")
  timezone      String   @default("UTC")
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum CouponType {
  /// Pushes the user's trial end date out by `value_days`. Touches the
  /// Subscription row directly, because "your trial is longer" is exactly
  /// what that row already means.
  TRIAL_EXTENSION

  /// Grants PRO-level limits for `value_days` without a Subscription change.
  /// Read at entitlement time, so it expires on its own and leaves the
  /// underlying subscription untouched underneath it.
  FREE_PRO
}

/// A redeemable code.
///
/// `code` is uppercase and generated with real entropy — see
/// `scripts/coupons.ts`. A guessable code attached to a free-PRO grant is an
/// open till, and walking a coupon namespace is a standard attack, which is
/// also why redemption is rate limited per user.
enum SubscriptionAuthStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One attempt to subscribe through the bdApps gateway.
///
/// The gateway sends the user off to `user.bdapps.com`, then bounces them back
/// to `redirectUrl` with a result. That return carries a `requestId` and
/// nothing that proves who the person is — our session cookie does not survive
/// the round trip through an external site on mobile. So the mapping from
/// requestId to user has to be written down BEFORE the user leaves, and this
/// is that record.
///
/// `request_id` is unique, which is also what makes the return idempotent: a
/// user who refreshes the return page, or a gateway that retries it, cannot
/// grant a second subscription period.
model SubscriptionAuthorization {
  id           String                 @id @default(uuid())
  user_id      String
  /// The `requestId` we sent to the gateway. Unique per attempt.
  request_id   String                 @unique
  /// The exact `requestTime` string that was signed. Kept verbatim because
  /// the signature is over the string, not over a parsed date.
  request_time String
  status       SubscriptionAuthStatus @default(PENDING)
  plan_name    String                 @default("PRO")
  /// Whatever the gateway put on the return URL, for support and debugging.
  return_payload Json?
  created_at   DateTime               @default(now())
  completed_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
}

/// What bdApps told us, unprompted, about a subscription.
///
/// THE REASON THIS TABLE EXISTS
///
/// bdApps offers no way to ask about a bKash subscription. `getStatus` answers
/// only for carrier billing - a real, paying bKash number comes back E1951
/// "already unregistered" - and the bridge's own subscriber list is a plain
/// local file whose `verified` flag is hardcoded false. So every bKash
/// "confirmation" we had was really us reading back something we or the
/// reference page had written, which is why a cancelled payment still granted
/// PRO: the number was already on the list from a previous purchase.
///
/// The subscription notification is the one thing bdApps sends on its own
/// account (see BkashBddapps/subscription_listener.php). Recording it here -
/// in our database, not in a file anyone can POST to - makes "bdApps confirmed
/// this" a fact we hold rather than an inference we make.
model BdappsSubscriptionEvent {
  id             String   @id @default(uuid())
  /// Exactly what they sent, which is sometimes a plain MSISDN and sometimes
  /// an opaque per-application token.
  subscriber_id  String
  /// Normalised to 01XXXXXXXXX when the subscriber id was a number we could
  /// read, null when it was a token. Only rows with a phone can be matched.
  phone          String?
  /// REGISTERED or UNREGISTERED.
  status         String
  application_id String?
  /// Their timestamp, kept verbatim.
  time_stamp     String?
  received_at    DateTime @default(now())

  @@index([phone, received_at])
  @@index([subscriber_id])
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  type             CouponType
  value_days       Int
  /// NULL means unlimited redemptions.
  max_redemptions  Int?
  redemptions_used Int       @default(0)
  valid_from       DateTime?
  valid_until      DateTime?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([code, is_active])
}

/// One row per (coupon, user). The composite unique is the one-per-user rule —
/// enforced by the database rather than by a check-then-insert, which two
/// concurrent requests would both pass.
model CouponRedemption {
  id          String   @id @default(uuid())
  coupon_id   String
  user_id     String
  redeemed_at DateTime @default(now())
  /// When the grant lapses. For FREE_PRO this is what the entitlement lookup
  /// compares against; for TRIAL_EXTENSION it records the new trial end.
  expires_at  DateTime

  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([coupon_id, user_id])
  /// Serves the "does this user have a live grant right now" lookup that runs
  /// on every plan resolution.
  @@index([user_id, expires_at])
}

/// A long-lived, opaque, revocable handle that a device exchanges for a
/// short-lived access JWT.
///
/// Only the SHA-256 hash of the token is stored. The raw value is returned
/// exactly once, at issue time, and lives thereafter only in the device
/// keystore — so a dump of this table cannot be replayed against the API.
///
/// Rotation: every successful refresh revokes the presented token and issues
/// a new one. A revoked token being presented again means it was captured and
/// replayed (or the legitimate client raced itself), so that event revokes
/// the user's whole family of tokens rather than trusting the caller.
model RefreshToken {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  /// Free-text device hint ("Pixel 8", "SM-A546B") so a user can tell their
  /// sessions apart in a future "signed-in devices" screen.
  device_label String?
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime
  revoked_at   DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
}

model Subscription {
  id                   String             @id @default(uuid())
  user_id              String             @unique
  plan_id              String
  status               SubscriptionStatus @default(ACTIVE)
  current_period_start DateTime
  current_period_end   DateTime
  cancelled_at         DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id])
  plan Plan @relation(fields: [plan_id], references: [id])

  @@index([status, current_period_end])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}
model House {
  id          String    @id @default(uuid())
  owner_id    String
  name        String
  address     String
  city        String
  country     String
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  owner            User             @relation(fields: [owner_id], references: [id])
  units            Unit[]
  expenses         Expense[]
  other_income     OtherIncome[]
  report_snapshots ReportSnapshot[]
  rent_charges     RentCharge[]
  leases           Lease[]

  @@index([owner_id, deleted_at])
  @@index([owner_id])
}

model Unit {
  id          String    @id @default(uuid())
  house_id    String
  name        String
  floor       String?
  bedrooms    Int       @default(1)
  bathrooms   Int       @default(1)
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  house        House         @relation(fields: [house_id], references: [id])
  leases       Lease[]
  rent_rates   RentRate[]
  rent_charges RentCharge[]
  expenses     Expense[]
  other_income OtherIncome[]

  @@index([house_id, deleted_at])
  @@index([house_id])
}

model Tenant {
  id             String    @id @default(uuid())
  owner_id       String
  full_name      String
  email          String?
  phone          String?
  photo_url      String?
  // Stores either a remote URL or a base64/data URL for the tenant's ID
  // card image. Surfaced in the read-only details sheet alongside the
  // profile photo so the operator can verify the tenant's identity
  // without leaving the app.
  nid_image_url  String?
  id_type        String?
  id_number      String?
  date_of_birth  DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  leases         Lease[]
  rent_charges   RentCharge[]
  family_members TenantFamilyMember[]
  attachments    Attachment[] @relation("TenantAttachments")
  email_logs     EmailLog[]   @relation("TenantEmails")

  @@index([owner_id, deleted_at])
  @@index([owner_id, full_name])
  @@index([email])
}

model TenantFamilyMember {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  relation   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model Lease {
  id               String      @id @default(uuid())
  house_id         String
  unit_id          String
  tenant_id        String
  status           LeaseStatus @default(ACTIVE)
  start_date       DateTime
  end_date         DateTime?
  move_in_date     DateTime
  move_out_date    DateTime?
  security_deposit Decimal     @db.Decimal(14, 2) @default(0)
  ended_reason     String?
  notes            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  house        House        @relation(fields: [house_id], references: [id])
  unit         Unit         @relation(fields: [unit_id], references: [id])
  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  rent_charges RentCharge[]
  attachments  Attachment[] @relation("LeaseAttachments")

  @@index([unit_id, status])
  @@index([house_id, status])
  @@index([tenant_id])
  @@index([status, end_date])
  @@index([house_id, tenant_id])
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model RentRate {
  id             String    @id @default(uuid())
  unit_id        String
  amount         Decimal   @db.Decimal(14, 2)
  effective_from DateTime
  effective_to   DateTime?
  set_by         String
  notes          String?
  created_at     DateTime  @default(now())

  unit Unit @relation(fields: [unit_id], references: [id])

  @@index([unit_id, effective_to])
  @@index([unit_id, effective_from])
}
model RentCharge {
  id          String           @id @default(uuid())
  house_id    String
  unit_id     String
  lease_id    String
  tenant_id   String
  due_month   String
  due_date    DateTime
  amount_due  Decimal          @db.Decimal(14, 2)
  status      RentChargeStatus @default(UNPAID)
  notes       String?
  voided_at   DateTime?
  void_reason String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  house    House     @relation(fields: [house_id], references: [id])
  unit     Unit      @relation(fields: [unit_id], references: [id])
  lease    Lease     @relation(fields: [lease_id], references: [id])
  tenant   Tenant    @relation(fields: [tenant_id], references: [id])
  payments Payment[]

  @@unique([unit_id, lease_id, due_month])
  @@index([house_id, due_month])
  @@index([lease_id])
  @@index([tenant_id, due_month])
  @@index([status, due_date])
  @@index([house_id, status])
}

enum RentChargeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  VOIDED
}

model Payment {
  id              String        @id @default(uuid())
  rent_charge_id  String
  amount          Decimal       @db.Decimal(14, 2)
  date_paid       DateTime
  method          PaymentMethod
  status          PaymentStatus @default(CONFIRMED)
  reference_no    String?
  idempotency_key String        @unique
  recorded_by     String
  notes           String?
  void_reason     String?
  voided_at       DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  rent_charge RentCharge   @relation(fields: [rent_charge_id], references: [id])
  attachments Attachment[] @relation("PaymentAttachments")

  @@index([rent_charge_id, status])
  @@index([date_paid])
  @@index([status, date_paid])
  @@index([recorded_by])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
  REFUNDED
}

model Expense {
  id              String          @id @default(uuid())
  house_id        String
  unit_id         String?
  category        ExpenseCategory
  custom_category String?
  amount          Decimal         @db.Decimal(14, 2)
  expense_date    DateTime
  description     String?
  vendor          String?
  // Cloudinary URL for a photo of the receipt. Nullable and additive: rows
  // created before this column existed simply have no receipt. Mirrors
  // `Tenant.photo_url` / `Tenant.nid_image_url` rather than using the
  // `Attachment` table, because the UI shows exactly one image and a scalar
  // avoids a join on every expense list query.
  receipt_url     String?
  created_by      String
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  deleted_at      DateTime?

  house       House        @relation(fields: [house_id], references: [id])
  unit        Unit?        @relation(fields: [unit_id], references: [id])
  attachments Attachment[] @relation("ExpenseAttachments")

  @@index([house_id, expense_date, deleted_at])
  @@index([house_id, category])
  @@index([unit_id, expense_date])
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITIES
  INSURANCE
  PROPERTY_TAX
  MANAGEMENT_FEE
  CLEANING
  LANDSCAPING
  LEGAL
  MARKETING
  SUPPLIES
  RENOVATION
  OTHER
}
model OtherIncome {
  id          String          @id @default(uuid())
  house_id    String
  unit_id     String?
  type        OtherIncomeType
  amount      Decimal         @db.Decimal(14, 2)
  income_date DateTime
  description String?
  created_by  String
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  deleted_at  DateTime?

  house       House        @relation(fields: [house_id], references: [id])
  unit        Unit?        @relation(fields: [unit_id], references: [id])
  attachments Attachment[] @relation("OtherIncomeAttachments")

  @@index([house_id, income_date, deleted_at])
  @@index([house_id, type])
}

enum OtherIncomeType {
  PARKING
  LAUNDRY
  LATE_FEE
  PET_FEE
  STORAGE
  SECURITY_DEPOSIT_FORFEITURE
  UTILITY_REIMBURSEMENT
  OTHER
}

model Attachment {
  id              String    @id @default(uuid())
  owner_type      String
  owner_id        String
  document_type   String?
  file_key        String    @unique
  file_url        String
  file_name       String
  mime_type       String
  size_bytes      Int
  uploaded_by     String
  created_at      DateTime  @default(now())
  deleted_at      DateTime?
  payment_id      String?
  expense_id      String?
  lease_id        String?
  other_income_id String?
  tenant_id       String?

  payment      Payment?     @relation("PaymentAttachments", fields: [payment_id], references: [id])
  expense      Expense?     @relation("ExpenseAttachments", fields: [expense_id], references: [id])
  lease        Lease?       @relation("LeaseAttachments", fields: [lease_id], references: [id])
  other_income OtherIncome? @relation("OtherIncomeAttachments", fields: [other_income_id], references: [id])
  tenant       Tenant?      @relation("TenantAttachments", fields: [tenant_id], references: [id])

  @@index([owner_type, owner_id])
  @@index([tenant_id, document_type])
  @@index([deleted_at])
}

model AuditLog {
  id           String      @id @default(uuid())
  entity_type  String
  entity_id    String
  action       AuditAction
  actor_id     String
  before_state Json?
  after_state  Json?
  ip_address   String?
  user_agent   String?
  created_at   DateTime    @default(now())

  actor User @relation("AuditActor", fields: [actor_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([actor_id, created_at])
  @@index([created_at])
  @@index([action, entity_type])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  VOID
  REFUND
  MOVE_IN
  MOVE_OUT
  GENERATE
  RECALCULATE
}

model ReportSnapshot {
  id                   String     @id @default(uuid())
  house_id             String
  period_type          PeriodType
  period_key           String
  total_rent_collected Decimal    @db.Decimal(14, 2)
  total_other_income   Decimal    @db.Decimal(14, 2)
  total_expenses       Decimal    @db.Decimal(14, 2)
  net_income           Decimal    @db.Decimal(14, 2)
  occupied_units       Int
  vacant_units         Int
  overdue_amount       Decimal    @db.Decimal(14, 2)
  rent_roll            Json
  data                 Json
  is_final             Boolean    @default(false)
  generated_at         DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  house House @relation(fields: [house_id], references: [id])

  @@unique([house_id, period_type, period_key])
  @@index([house_id, period_key])
  @@index([is_final, period_key])
}

enum PeriodType {
  MONTHLY
  YEARLY
}

model RateLimitToken {
  id         String   @id @default(uuid())
  key        String
  created_at DateTime @default(now())

  @@index([key, created_at])
}

/// Outbound notification attempts to tenants.
///
/// Three jobs, all load-bearing:
///   1. **Idempotency.** `dedupe_key` is UNIQUE, so a retried request cannot
///      mail a tenant the same invoice twice. POST /api/payments returns the
///      EXISTING payment when an idempotency key repeats, and without this the
///      retry would look like a fresh send.
///   2. **Visibility.** A send that fails must not fail the payment write, so
///      failures are swallowed at the call site — this table is the only place
///      they surface. Without it, "did the tenant get their receipt?" would be
///      unanswerable.
///   3. **Retry.** A FAILED row carries everything needed to send again.
///
/// `channel` exists because email is the first adapter, not the only intended
/// one: in Bangladesh SMS/WhatsApp reach tenants far more reliably, and
/// `Tenant.email` is nullable precisely because it is often missing.
model EmailLog {
  id          String    @id @default(uuid())
  /// Landlord whose action triggered this. Null if the tenant row is gone.
  user_id     String?
  tenant_id   String?
  kind        String
  channel     String    @default("EMAIL")
  to_address  String
  subject     String?
  /// Stable identity of the underlying event, NOT of the send attempt.
  dedupe_key  String    @unique
  status      String    @default("PENDING")
  provider_id String?
  error       String?
  created_at  DateTime  @default(now())
  sent_at     DateTime?

  tenant Tenant? @relation("TenantEmails", fields: [tenant_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([status, created_at])
}
