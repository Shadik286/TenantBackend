# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Runtime DB (Supabase Transaction pooler, port 6543) — used by the running
# Next.js server. The pgbouncer flag + connection_limit=1 are required so
# Prisma disables prepared statements and stays under Supabase's connection cap.
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations / introspection from your laptop — direct (port 5432 on db.<ref>).
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# Google Sign In (Play Store build) — comma-separated allow-list of OAuth
# client IDs accepted in the `aud` claim of the ID token the Flutter app sends
# to /api/auth/google/login.
#
# IMPORTANT: on Android the token's `aud` is the **Web** client ID (the one you
# pass to the plugin as serverClientId), NOT the Android client ID. Putting the
# Android ID here produces confusing "audience mismatch" 401s.
# Add the iOS client ID too if you ship an iOS build.
#
# Leave unset and /api/auth/google/login answers 503 rather than skipping
# audience validation.
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com

# Cloudinary — server-side credentials used to upload tenant photos and ID
# card images. The Flutter app NEVER sees these; it uploads through
# /api/uploads/cloudinary, which signs the request with the API secret.
# Get these from https://console.cloudinary.com/ (Account Details).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# --- Mail transport -----------------------------------------------------------
# Two options. Set ONE. SMTP wins if both are present.
#
# OPTION A — Gmail SMTP. The only way to send FROM an @gmail.com address.
#
#   Resend and every other transactional API require SPF + DKIM DNS records on
#   the sending domain to prove you own it. You cannot publish DNS for
#   gmail.com, so `from: you@gmail.com` can never be verified there — and since
#   Google/Yahoo tightened bulk-sender rules in 2024, unaligned mail is rejected
#   or filed as spam. Gmail's own SMTP is different: you authenticate AS the
#   account, so the From address is legitimately yours.
#
#   SMTP_PASSWORD must be a 16-character APP PASSWORD, not the account
#   password. Generate at myaccount.google.com/apppasswords — the option only
#   appears once 2-Step Verification is on.
#
#   Limits worth knowing: ~500 recipients/day on free Gmail (2,000 on
#   Workspace). Every payment sends a receipt, so that is the real ceiling.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rentensoftware@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Renten <rentensoftware@gmail.com>"

# OPTION B — Resend. Better once you own a domain: no daily cap, faster, and it
# reports bounces. Requires a domain verified with SPF/DKIM in the Resend
# dashboard; a gmail.com from-address will be rejected.
# Leave both blank while using SMTP above.
RESEND_API_KEY=
RESEND_FROM=
