# Server-only Supabase values. Do NOT prefix these with NEXT_PUBLIC_.
# This file is the safe template — copy to .env and fill in real secrets.

# Public project URL (same value as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=https://njhcndhjqecyouehcjkm.supabase.co

# --- Database (Supabase) -------------------------------------------------
# Runtime queries from the Next.js server (Vercel serverless). Use the
# Transaction pooler on port 6543 with pgbouncer mode + a small connection
# limit per invocation. The pooler requires the special ?pgbouncer=true flag
# so Prisma switches off prepared statements.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations / introspection / scripts on your laptop. Direct connection
# (port 5432 on db.<ref>.supabase.co) is required because the pooler does
# not support advisory locks or DDL transactions.
DIRECT_DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Server-side secret key. Replace the placeholder below with the real
# sb_secret_... value from Supabase Dashboard -> Settings -> API Keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Browser-safe publishable key (NEXT_PUBLIC_ so it's inlined into the bundle).
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Conventional Supabase name. Same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# JWKS endpoint for verifying JWTs.
SUPABASE_JWKS_URL=https://[ref].supabase.co/auth/v1/.well-known/jwks.json

# NextAuth
NEXTAUTH_SECRET=replace_with_32_char_random_string
NEXTAUTH_URL=https://your-app.vercel.app

# CORS — comma-separated list of browser origins. Empty = wildcard.
ALLOWED_ORIGINS=

# Cron security — set the same value in Vercel -> Environment Variables.
CRON_SECRET=replace_with_random_string

# Cloudflare R2 (optional, for attachment uploads)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend (optional, for email reminders)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com